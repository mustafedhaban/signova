# Database
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET=change-me-in-production
REFRESH_TOKEN_SECRET=change-me-in-production-too

# Frontend (share links, email CTA URLs)
FRONTEND_URL=http://localhost:5173

# Email — pick one provider (defaults to console log when unset)
# MAIL_PROVIDER=console|resend|smtp
MAIL_FROM="Signova <noreply@yourdomain.com>"

# Resend (https://resend.com) — set MAIL_PROVIDER=resend or leave unset with API key
RESEND_API_KEY=

# SMTP (e.g. Gmail relay, SendGrid SMTP, Mailgun)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
