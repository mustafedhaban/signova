{
  "name": "signova",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm --parallel --filter @signova/api --filter @signova/web dev",
    "dev:api": "pnpm --filter @signova/api dev",
    "dev:web": "pnpm --filter @signova/web dev",
    "build": "pnpm --filter @signova/api build && pnpm --filter @signova/web build",
    "lint": "pnpm --filter @signova/api lint && pnpm --filter @signova/web lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.2",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "prettier": "^3.8.3"
  }
}
